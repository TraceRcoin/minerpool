# Tracercoin MAINNET payout monitor — environment template.
#
# Copy to /opt/tfxpool/pool.env on pool-1 (root:root, chmod 600) and load it via the
# systemd unit's EnvironmentFile=. The real pool.env is git-ignored (*.env) and must
# NEVER be committed — it carries the wallet passphrase.
#
#   cp pool.env.example /opt/tfxpool/pool.env
#   chmod 600 /opt/tfxpool/pool.env
#   # then edit the secret + tune the knobs
#
# Nothing here is echoed by the monitor; POOL_WALLET_PASSPHRASE is read and used only
# to unlock the wallet for the short window around sends, then the wallet is re-locked.

# --- pool DB (the pool's local stats/ledger DB on pool-1) ---
POOL_DB=/var/lib/tfxpool-main/portal.db

# --- mainnet daemon CLI: mainnet datadir, pool wallet, NO -testnet, RPC 9556 ---
TFX_CLI=/root/mainbin/tracercoin-cli -datadir=/root/.tracercoin-main -rpcwallet=poolwallet

# --- payout policy ---
COINBASE_MATURITY=100
MINIMUM_PAYOUT=1          # TFX; credits below this wait until they accrue
PAYOUT_INTERVAL=300       # seconds between payout passes in the loop

# --- dev-fee sweep ---
DEV_FEE=0.02                                                   # 2% dev fee
TREASURY_ADDRESS=tfx1ql6qduelyr9xuz7wv0q7nt3hlr0am0ssqtss8kl  # sweep destination
HOT_WALLET_FLOAT=10       # TFX kept in the hot wallet; only the excess dev fee is swept
MIN_SWEEP=1              # TFX; don't sweep dust
SWEEP_EVERY=12           # sweep once every N payout passes in the loop (0 = never; use --sweep)

# --- encrypted wallet (leave POOL_WALLET_PASSPHRASE empty if the wallet is unencrypted) ---
POOL_WALLET_PASSPHRASE=
WALLET_UNLOCK_SECONDS=60

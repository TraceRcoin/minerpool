# Tracercoin pool environment — TEMPLATE.
#
# Copy to /opt/tfxpool/pool.env on the pool box (root:root, chmod 600) and fill the
# real values. The real pool.env is git-ignored (never commit secrets). Reference it
# from the systemd units as: EnvironmentFile=/opt/tfxpool/pool.env
#
#   install -o root -g root -m 600 pool.env.example /opt/tfxpool/pool.env  # then edit
#
# Consumed by: ingest_client.js (flusher), portal_bridge.js (worker-auth), payout_monitor.py

# Production portal base URL (worker-auth + ingest share this). HTTPS in prod.
PORTAL_BASE_URL=https://tracercoin.org

# Worker-auth shared secret — copy the PROD value from empire-web-1's
# /etc/tracercoin/waitlist.env (POOL_INTERNAL_TOKEN) over SSH. Never echo/commit.
POOL_INTERNAL_TOKEN=

# Ingest secret — the SAME value set as POOL_INGEST_TOKEN in the backend's
# /etc/tracercoin/waitlist.env. SEPARATE from the worker-auth token above.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POOL_INGEST_TOKEN=

# Local spool DB (the pool's own ledger + retry journal). WAL; created if absent.
SPOOL_DB=/var/lib/tfxpool/spool.db

# Mainnet wallet CLI for payout_monitor.py (no -testnet; -rpcwallet=poolwallet).
TFX_CLI=/usr/local/bin/tracercoin-cli -datadir=/root/.tracercoin -rpcwallet=poolwallet
COINBASE_MATURITY=100
MINIMUM_PAYOUT=0
MONITOR_INTERVAL=30
